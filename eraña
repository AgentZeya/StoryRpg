		if LocalPlayer.UserId == id then return true end
	end
	return false
end

local function hasPermanentAccess()
	local ok, result = pcall(function()
		if isfile and isfile(KEY_SAVE_FILE) then
			return readfile(KEY_SAVE_FILE) == "UNLOCKED"
		end
		return false
	end)
	return ok and result
end

local function savePermanentAccess()
	pcall(function()
		if writefile then writefile(KEY_SAVE_FILE, "UNLOCKED") end
	end)
end

