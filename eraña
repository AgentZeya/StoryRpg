	end)

	PotionBtn.MouseButton1Click:Connect(function()
		autoPotion = not autoPotion
		PotionBtn.Text = autoPotion and "AUTO POTION: ON" or "AUTO POTION: OFF"
		PotionStroke.Color = autoPotion and COLOR_STROKE_ON or COLOR_STROKE_OFF
		PotionBtn.BackgroundColor3 = autoPotion and COLOR_PANEL_ALT or COLOR_PANEL
	end)

	-- WORLD 2 BOSS toggle — uses the FARM TAB system
	W2ToggleBtn.MouseButton1Click:Connect(function()
		world2BossActive = not world2BossActive
		if world2BossActive then
			W2ToggleBtn.Text = "WORLD 2 BOSS: ON"
			W2ToggleStroke.Color = COLOR_ACCENT
			W2ToggleBtn.BackgroundColor3 = COLOR_PANEL_ALT

			-- Start using the farm tab's walk+attack system
			isFarming = true
			selectedMobNames = { WB2_BOSS1_NAME }
			currentTargetMob = nil
			world2Phase = 1
			lastForestSeen = false
			lastGoblinSeen = false
			world2BossStatus = "Phase 1: Looking for ForestKeeper_m"

			-- TP to ForestKeeper spawn so farm tab can immediately find him
			teleportTo(WB2_BOSS1_POS)
		else
			W2ToggleBtn.Text = "WORLD 2 BOSS: OFF"
			W2ToggleStroke.Color = COLOR_STROKE_OFF
			W2ToggleBtn.BackgroundColor3 = COLOR_PANEL
			isFarming = false
			selectedMobNames = {}
			currentTargetMob = nil
			world2BossStatus = "Idle"
		end
	end)

	-- Mob list
	local function clearList()
		for _, child in pairs(Scroller:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
	end

	local function updateMobList()
		clearList()
		local query = string.lower(SearchBox.Text)
		local aliveMobs = {}
		for _, folder in ipairs(getMobFolders()) do
			for _, mob in ipairs(folder:GetChildren()) do
				if mob:IsA("Model") and getHRP(mob) then
					local hum = mob:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 then
						local baseName = getBaseName(mob.Name)
						if query == "" or string.find(string.lower(baseName), query) then
							aliveMobs[baseName] = (aliveMobs[baseName] or 0) + 1
						end
					end
				end
			end
		end
		local sortedNames = {}
		for name in pairs(aliveMobs) do table.insert(sortedNames, name) end
		table.sort(sortedNames)
		for _, mobName in ipairs(sortedNames) do
			local count = aliveMobs[mobName]
			local isSelected = false
			for _, sel in ipairs(selectedMobNames) do
				if sel:lower() == mobName:lower() then isSelected = true break end
			end
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, 0, 0, 22)
			btn.BackgroundColor3 = isSelected and COLOR_PANEL_ALT or COLOR_PANEL
			btn.Text = mobName .. " (x" .. count .. ")"
			btn.TextColor3 = COLOR_TEXT
			btn.Font = Enum.Font.GothamBold
			btn.TextSize = 8
			btn.Parent = Scroller
			roundCorner(btn, 4)
			addStroke(btn, isSelected and COLOR_STROKE_ON or COLOR_STROKE_OFF, 1)
			btn.MouseButton1Click:Connect(function()
				toggleMobSelection(mobName)
				currentTargetMob = nil
				updateMobList()
			end)
		end
	end

	SearchBox:GetPropertyChangedSignal("Text"):Connect(updateMobList)

	task.spawn(function()
		while task.wait(2.5) do updateMobList() end
	end)

	updateMobList()
end

if bypassKey then
	buildMainUI()
end
