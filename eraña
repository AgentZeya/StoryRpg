local HP_POTION_PRIORITY = {"HpL", "HpM", "HpS"}
local MP_POTION_PRIORITY = {"MpL", "MpM", "MpS"}

local function findUsablePotion(priorityList)
	for _, potionId in ipairs(priorityList) do
		local count = getPotionCount(potionId)
		if count == nil then return priorityList[1]
		elseif count > 0 then return potionId end
	end
	return nil
end

task.spawn(function()
