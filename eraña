-- Searches ALL descendants of _Runtime so bosses are found no matter how deep
local function findBossByName(bossBaseName)
	local runtime = Workspace:FindFirstChild("_Runtime")
	if not runtime then return nil end
	for _, mob in ipairs(runtime:GetDescendants()) do
		if mob:IsA("Model") and getHRP(mob) then
			if getBaseName(mob.Name):lower() == bossBaseName:lower() then
				local hum = mob:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then return mob end
			end
		end
	end
	return nil
end

local function teleportTo(pos)
	local hrp = getMyHRP()
	if not hrp then return end
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	hrp.CFrame = CFrame.new(pos)
end

-- ==========================================
-- 🌲 WORLD 2 BOSS — MONITOR LOOP (uses FARM TAB system)
-- ==========================================
-- This loop just detects boss death and switches the FARM TAB's selectedMobNames.
-- The actual walking + attacking is handled by the regular RenderStepped farm loop.
task.spawn(function()
	while task.wait(0.3) do
		if world2BossActive then
			local fk = findBossByName(WB2_BOSS1_NAME)
			local mg = findBossByName(WB2_BOSS2_NAME)

			if world2Phase == 1 then
				-- Phase 1: ForestKeeper_m
				if fk then
					lastForestSeen = true
					world2BossStatus = "Phase 1: Fighting ForestKeeper_m"
				else
					if lastForestSeen then
						-- ForestKeeper just died → switch to MotherGoblin
						lastForestSeen = false
						world2BossStatus = "Phase 2: TP to MotherGoblin_m"
						teleportTo(WB2_BOSS2_POS)
						selectedMobNames = { WB2_BOSS2_NAME }
						currentTargetMob = nil
						world2Phase = 2
						task.wait(1)
					else
						-- ForestKeeper not spawned yet, wait at his spawn
						world2BossStatus = "Phase 1: Waiting for ForestKeeper_m to spawn..."
						local hrp = getMyHRP()
						if hrp and (hrp.Position - WB2_BOSS1_POS).Magnitude > 30 then
							teleportTo(WB2_BOSS1_POS)
						end
						selectedMobNames = { WB2_BOSS1_NAME }
						task.wait(1)
					end
				end
			elseif world2Phase == 2 then
				-- Phase 2: MotherGoblin_m
				if mg then
					lastGoblinSeen = true
					world2BossStatus = "Phase 2: Fighting MotherGoblin_m"
				else
					if lastGoblinSeen then
						-- MotherGoblin just died → switch back to ForestKeeper
						lastGoblinSeen = false
						world2BossStatus = "Phase 3: TP to ForestKeeper_m"
						teleportTo(WB2_BOSS1_POS)
						selectedMobNames = { WB2_BOSS1_NAME }
						currentTargetMob = nil
						world2Phase = 1
						task.wait(1)
					else
						-- MotherGoblin not spawned yet, wait at her location
						world2BossStatus = "Phase 2: Waiting for MotherGoblin_m to spawn..."
						local hrp = getMyHRP()
						if hrp and (hrp.Position - WB2_BOSS2_POS).Magnitude > 30 then
							teleportTo(WB2_BOSS2_POS)
						end
						selectedMobNames = { WB2_BOSS2_NAME }
						task.wait(1)
					end
				end
			end
		else
			-- Reset when toggled off
			lastForestSeen = false
			lastGoblinSeen = false
		end
	end
end)

