local function getBaseName(name)
	local base = string.gsub(name, "%d+$", "")
	base = string.gsub(base, "_+$", "")
	return base
end

local function getHRP(model)
	if not model then return nil end
	return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso") or model.PrimaryPart
end

local function getMyHRP()
	local char = LocalPlayer.Character
	if not char then return nil end
	return getHRP(char)
end

local function getSafeZoneBasePart()
	local hz = Workspace:FindFirstChild("HealthZones")
	if not hz then return nil end
	for _, desc in ipairs(hz:GetDescendants()) do
		if desc:IsA("BasePart") then
			if desc.Name == "default" or desc.Name == "Circle" or (desc.Parent and desc.Parent.Name == "Platform") then
				return desc
			end
		end
	end
	return hz:FindFirstChildWhichIsA("BasePart", true)
end

local function getMobFolders()
	local folders = {}
	local runtime = Workspace:FindFirstChild("_Runtime")
	if runtime then
		local boss = runtime:FindFirstChild("Boss")
		local monsters = runtime:FindFirstChild("Monsters")
		if boss then table.insert(folders, boss) end
		if monsters then table.insert(folders, monsters) end
	end
	return folders
end

local function isMobSelected(name)
	local baseName = getBaseName(name)
	if #selectedMobNames == 0 then return true end
	for _, selectedName in ipairs(selectedMobNames) do
		if baseName:lower() == selectedName:lower() then return true end
	end
	return false
end

local function toggleMobSelection(mobName)
	for i, name in ipairs(selectedMobNames) do
		if name:lower() == mobName:lower() then
			table.remove(selectedMobNames, i)
			return
		end
	end
	table.insert(selectedMobNames, mobName)
end

