-- ===== FARM TAB RenderStepped (also used by World 2 Boss) =====
RunService.RenderStepped:Connect(function()
	if isFarming and not isHealingInSafeZone then
		local char = LocalPlayer.Character
		local hrp = char and getHRP(char)
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 then
			if not currentTargetMob or not currentTargetMob.Parent then
				currentTargetMob = nil
			else
				local tHum = currentTargetMob:FindFirstChildOfClass("Humanoid")
				if not tHum or tHum.Health <= 0 then currentTargetMob = nil end
			end
			if not currentTargetMob then
				local closestDist = math.huge
				for _, folder in ipairs(getMobFolders()) do
					for _, mob in ipairs(folder:GetChildren()) do
						if mob:IsA("Model") and getHRP(mob) then
							if isMobSelected(mob.Name) then
								local tHum = mob:FindFirstChildOfClass("Humanoid")
								local tHrp = getHRP(mob)
								if tHum and tHrp and tHum.Health > 0 then
									local dist = (tHrp.Position - hrp.Position).Magnitude
									if dist < closestDist then
										closestDist = dist
										currentTargetMob = mob
									end
								end
							end
						end
					end
				end
			end
			if currentTargetMob then
				local tHrp = getHRP(currentTargetMob)
				if tHrp then
					local targetCFrame = tHrp.CFrame * CFrame.new(0, 0, farmDistance)
					if (hrp.Position - targetCFrame.Position).Magnitude > 0.5 then
						local lookAtCFrame = CFrame.lookAt(targetCFrame.Position, tHrp.Position)
						hrp.AssemblyLinearVelocity = Vector3.zero
						hrp.AssemblyAngularVelocity = Vector3.zero
						hrp.CFrame = hrp.CFrame:Lerp(lookAtCFrame, 0.25)
					end
				end
			end
		end
	end
end)

