local function buildSellItemsList()
	local list = {}
	for _, itemId in ipairs(SELLABLE_ITEMS) do
		local count = getSellableCount(itemId)
		if count == nil then
			table.insert(list, {id = itemId, count = 99})
		elseif count > 0 then
			table.insert(list, {id = itemId, count = math.min(count, 99)})
		end
	end
	return list
end

