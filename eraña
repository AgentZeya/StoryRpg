local ClientStateModule, InventoryUtilModule
pcall(function() ClientStateModule = require(LocalPlayer.PlayerScripts.Controllers.ClientState) end)
pcall(function() InventoryUtilModule = require(ReplicatedStorage.Shared.InventoryUtil) end)

local function getPlayerState()
	if not ClientStateModule then return nil end
	local ok, state = pcall(function() return ClientStateModule.Get() end)
	if ok then return state end
	return nil
end

local function getSellableCount(itemId)
	local state = getPlayerState()
	if not state or not state.Inventory then return nil end
	if InventoryUtilModule and InventoryUtilModule.GetSellableCount then
		local ok, count = pcall(function() return InventoryUtilModule.GetSellableCount(state, itemId) end)
		if ok then return count or 0 end
	end
	local mats = state.Inventory.Materials
	return mats and (mats[itemId] or 0) or 0
end

local function getPotionCount(potionId)
	local state = getPlayerState()
	if not state or not state.Inventory then return nil end
	local potions = state.Inventory.Potions
	return potions and (potions[potionId] or 0) or 0
end

