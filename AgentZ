	-- MOB LIST POPULATION (multi-select)
	local function clearList()
		for _, child in pairs(Scroller:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
	end

	local function updateMobList()
		clearList()
		local query = string.lower(SearchBox.Text)
		local aliveMobs = {}

		local searchPaths = getMobFolders()
		for _, folder in ipairs(searchPaths) do
			for _, mob in ipairs(folder:GetChildren()) do
				if mob:IsA("Model") and getHRP(mob) then
					local hum = mob:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 then
						local baseName = getBaseName(mob.Name)
						if query == "" or string.find(string.lower(baseName), query) then
							aliveMobs[baseName] = (aliveMobs[baseName] or 0) + 1
						end
					end
				end
			end
		end

		local sortedNames = {}
		for name in pairs(aliveMobs) do table.insert(sortedNames, name) end
		table.sort(sortedNames)

		for _, mobName in ipairs(sortedNames) do
			local count = aliveMobs[mobName]
			local isSelected = false
			for _, sel in ipairs(selectedMobNames) do
				if sel:lower() == mobName:lower() then isSelected = true break end
			end

			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, 0, 0, 22)
			btn.BackgroundColor3 = isSelected and COLOR_PANEL_ALT or COLOR_PANEL
			btn.Text = mobName .. " (x" .. count .. ")"
			btn.TextColor3 = COLOR_TEXT
			btn.Font = Enum.Font.GothamBold
			btn.TextSize = 8
			btn.Parent = Scroller

			roundCorner(btn, 4)
			addStroke(btn, isSelected and COLOR_STROKE_ON or COLOR_STROKE_OFF, 1)

			btn.MouseButton1Click:Connect(function()
				toggleMobSelection(mobName)
				currentTargetMob = nil
				updateMobList()
			end)
		end
	end

	SearchBox:GetPropertyChangedSignal("Text"):Connect(updateMobList)

	task.spawn(function()
		while task.wait(2.5) do
			updateMobList()
		end
	end)

	updateMobList()
