-- Safe Zone monitor
task.spawn(function()
	while true do
		task.wait(0.2)
		if autoSafeZone then
			local char = LocalPlayer.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				local healthPct = (hum.Health / hum.MaxHealth) * 100
				if healthPct <= safeZonePercent and not isHealingInSafeZone then
					local targetPart = getSafeZoneBasePart()
					if targetPart then
						isHealingInSafeZone = true
					end
				elseif isHealingInSafeZone and hum.Health >= (hum.MaxHealth * 0.98) then
					isHealingInSafeZone = false
				end
			else
				isHealingInSafeZone = false
			end
		else
			isHealingInSafeZone = false
		end
	end
end)

